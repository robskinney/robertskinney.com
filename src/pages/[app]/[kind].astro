---
import MaxWidthWrapper from "@/components/max-width-wrapper.astro";
import BaseLayout from "@/layouts/base-layout.astro";
import Prose from "@/components/prose.astro";
import { getCollection, render } from "astro:content";

// One page per entry in the "Legal pages" collection, at /<app>/<kind>.
export async function getStaticPaths() {
  const pages = await getCollection("legal");
  return pages.map((page) => ({
    params: { app: page.data.app, kind: page.data.kind },
    props: { page },
  }));
}

const { page } = Astro.props;
const { Content } = await render(page);
---

<BaseLayout
  content={{
    title: `${page.data.appName} | ${page.data.title}`,
    description: `${page.data.title} for ${page.data.appName}`,
  }}
>
  <MaxWidthWrapper>
    <div class="flex flex-col items-start gap-1 my-4 pt-3">
      <p class="text-sm text-muted-foreground">{page.data.appName}</p>
      <h1 class="scroll-m-20 text-2xl font-semibold tracking-tight">
        {page.data.title}
      </h1>
      <p class="muted text-muted-foreground">
        Last updated {
          page.data.updatedAt.toLocaleDateString("en-US", {
            year: "numeric",
            month: "long",
            day: "numeric",
            timeZone: "UTC",
          })
        }
      </p>
    </div>

    <Prose>
      <Content />
    </Prose>
  </MaxWidthWrapper>
</BaseLayout>
