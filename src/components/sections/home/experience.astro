---
import experienceData from "@/data/experience.json";

type Role = {
  title: string;
  location?: string;
  startDate: string;
  endDate?: string;
  highlights?: string[];
};

type Company = {
  company: string;
  logo?: string;
  roles?: Role[];
};

// Dates are stored as yyyy-MM-dd; parse as UTC so the month never shifts by timezone.
const formatMonth = (date: string) =>
  new Date(`${date}T00:00:00Z`).toLocaleDateString("en-US", {
    month: "long",
    year: "numeric",
    timeZone: "UTC",
  });

// One card per role, in the order they appear in experience.json (editable via Pages CMS).
const experience = (experienceData as Company[]).flatMap((company) =>
  (company.roles ?? []).map((role) => ({
    ...role,
    company: company.company,
    logo: company.logo,
    duration: `${formatMonth(role.startDate)} - ${
      role.endDate ? formatMonth(role.endDate) : "Present"
    }`,
  })),
);
---

<div class="flex flex-col gap-5 pb-3">
  <div class="w-full border-b border-muted-foreground/10 my-6"></div>

  <h2
    class="scroll-m-20 text-md font-semibold text-muted-foreground tracking-tight"
  >
    Experience
  </h2>

  <div class="flex flex-col gap-4">
    {
      experience.map((section) => (
        <div class="card border shadow-md dark:shadow-[inset_0_1px_0_0_rgba(255,255,255,0.1),inset_0_4px_32px_-4px_rgba(255,255,255,0.08)]">
          <header class="flex flex-row justify-between">
            <div class="flex flex-row items-center justify-center gap-x-3">
              {section.logo && (
                <img
                  src={section.logo}
                  alt={`${section.company} logo`}
                  class="size-6 rounded-xs object-contain"
                  width="24"
                  height="24"
                />
              )}

              <div class="flex flex-col">
                <h3 class="font-semibold">{section.title}</h3>
                <h3 class="text-muted-foreground text-sm">
                  {section.duration}
                </h3>
              </div>
            </div>
          </header>

          <section>
            <ul class="list-disc pl-5 space-y-2 muted">
              {(section.highlights ?? []).map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </section>
        </div>
      ))
    }
  </div>
</div>
