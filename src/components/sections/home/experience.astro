---
import EY from "@/components/icons/experience/ey.astro";

import experienceData from "@/data/experience.json";

// Maps the company name stored in experience.json (edited via Pages CMS) to its logo.
const companyLogos: Record<string, typeof EY> = { EY };

const experience = experienceData.map((entry) => ({
  ...entry,
  companyLogo: companyLogos[entry.company],
}));
---

<div class="flex flex-col gap-5 pb-3">
  <div class="w-full border-b border-muted-foreground/10 my-6"></div>

  <h2
    class="scroll-m-20 text-md font-semibold text-muted-foreground tracking-tight"
  >
    Experience
  </h2>

  <div class="flex flex-col gap-4">
    {
      experience.map((section) => (
        <div class="card border shadow-md dark:shadow-[inset_0_1px_0_0_rgba(255,255,255,0.1),inset_0_4px_32px_-4px_rgba(255,255,255,0.08)]">
          <header class="flex flex-row justify-between">
            <div class="flex flex-row items-center justify-center gap-x-3">
              {section.companyLogo && <section.companyLogo class="size-6" />}

              <div class="flex flex-col">
                <h3 class="font-semibold">{section.title}</h3>
                <h3 class="text-muted-foreground text-sm">
                  {section.durationShort}
                </h3>
              </div>
            </div>
          </header>

          <section>
            <ul class="list-disc pl-5 space-y-2 muted">
              {section.content.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </section>
        </div>
      ))
    }
  </div>
</div>
